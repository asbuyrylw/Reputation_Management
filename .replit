# Replit config — full-stack demo (Postgres + FastAPI API + Next.js console).
# The console is the single public web port (mapped to 80); it proxies /api/* to the
# local API. See replit/start.sh and REPLIT_DEMO.md.
run = "bash replit/start.sh"
entrypoint = "replit/start.sh"

[nix]
channel = "stable-24_05"

[env]
PORT = "3000"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
run = ["bash", "replit/start.sh"]
deploymentTarget = "vm"

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 bash replit/start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
