# Production build-time config for the Vercel deploy. PUBLIC, non-secret values only.
# The console fetches /api/* (same-origin) so the httpOnly session cookie + CSRF work without CORS;
# next.config.ts rewrites /api/* -> API_PROXY_TARGET (the Railway backend). Loaded by Next during
# `next build` (NODE_ENV=production); local dev uses .env.local instead.
NEXT_PUBLIC_API_BASE_URL=/api
API_PROXY_TARGET=https://courageous-generosity-production-8d0e.up.railway.app
