# ---------------------------------------------------------------------------
# Reputation Crowding-Out Engine -- environment configuration
# Copy to .env and fill in. Load with: `export $(grep -v '^#' .env | xargs)`
# (or use python-dotenv / direnv).
# ---------------------------------------------------------------------------

# Postgres connection (shared by all modules)
REP_DB_DSN=postgresql://USER:PASSWORD@localhost:5432/reputation

# Which LLM drives gap analysis + scoring + content drafting
# Options: anthropic | openai
ORCHESTRATOR=anthropic

# Orchestrator + answer-engine API keys (set the ones you use)
# Core answer engines: Perplexity, ChatGPT/OpenAI-search, Claude/Anthropic, Gemini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Expansion answer engines (optional -- adapters stay inactive until the key is set).
# Each only joins the audit/benchmark once its key is present; absent keys are not
# counted against coverage.
#   Grok (xAI, OpenAI-compatible):
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai
XAI_MODEL=grok-2-latest
#   Google AI Overview (via Serper.dev Google SERP -- captures the AI Overview/answer box):
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev
#   Bing Copilot (set BOTH the key and an OpenAI-compatible base URL for your provider):
BING_COPILOT_API_KEY=
BING_COPILOT_BASE_URL=
BING_COPILOT_MODEL=gpt-4o

# Model IDs (update to current model identifiers when you wire keys)
# Set inside ai_state_audit.py: ORCH_MODEL_ANTHROPIC / ORCH_MODEL_OPENAI

# Crawler
CRAWL_UA=ReputationEngineBot/1.0 (+audit)

# Output
REP_OUTPUT_DIR=output

# Crawler: set to 0 to ignore robots.txt (default respects it)
CRAWL_RESPECT_ROBOTS=1

# Crawler: set to 0 to disable pyseoanalyzer keyword\/SEO enrichment
CRAWL_USE_PYSEO=1

# Content generator (Module 6)
CONTENT_QUALITY_THRESHOLD=0.75
CONTENT_MAX_REVISIONS=2

# Timeline estimator (Module 7)
DOMINANCE_TARGET=0.6
BASE_MONTHLY_GAIN=0.12

# Structured logging: set REP_LOG_JSON=1 for JSON log lines; REP_LOG_LEVEL=INFO
REP_LOG_JSON=0
REP_LOG_LEVEL=INFO

# Firecrawl JS-render fetch (fixes client-side-rendered sites). auto = only when a page looks thin.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE=https://api.firecrawl.dev
CRAWL_FIRECRAWL_MODE=auto

# Cost levers
ORCH_MODEL_ANTHROPIC_CHEAP=claude-haiku-4-5-20251001
ORCH_MODEL_OPENAI_CHEAP=gpt-4o-mini
CRAWL_ADAPTIVE_SAMPLING=1

# ---------------------------------------------------------------------------
# NotebookLM API -- Rich Media Generation
# ---------------------------------------------------------------------------
# Google AI Studio API key with NotebookLM / Semantic Retrieval API access.
# Falls back to GEMINI_API_KEY when not set (same Google key works for both).
# API docs: https://ai.google.dev/gemini-api/docs/semantic-retrieval
NOTEBOOKLM_API_KEY=

# Base URL for the Semantic Retrieval / NotebookLM API (leave blank for default).
# Override for VPC Service Controls or staging environments.
NOTEBOOKLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Rich-media asset types to generate each cycle (comma-separated; blank = all).
# Types: podcast, report_audio, explainer_video, slide_deck, infographic,
#        research_brief, deep_article, blog_series, newsletter
# Example -- generate only the podcast and slide deck:
#   RICH_MEDIA_TYPES=podcast,slide_deck
RICH_MEDIA_TYPES=

# Enable rich-media generation in the monthly cycle (requires a NotebookLM key
# or GEMINI_API_KEY; in-house LLM fallback runs automatically when key is absent).
#   AGENT_RICH_MEDIA_IN_CYCLE=1
AGENT_RICH_MEDIA_IN_CYCLE=0

# ---------------------------------------------------------------------------
# Veo (Google) video generation -- pairs with production_brief.py
# ---------------------------------------------------------------------------
# Uses the same GEMINI_API_KEY; Veo access requires an allowlisted project.
# Set to 1 to enable Veo video-clip generation from production briefs.
#   VEO_ENABLED=1
VEO_ENABLED=0
