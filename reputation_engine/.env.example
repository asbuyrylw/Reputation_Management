# ---------------------------------------------------------------------------
# Reputation Crowding-Out Engine -- environment configuration
# Copy to .env and fill in. Load with: `export $(grep -v '^#' .env | xargs)`
# (or use python-dotenv / direnv).
# ---------------------------------------------------------------------------

# Postgres connection (shared by all modules)
REP_DB_DSN=postgresql://USER:PASSWORD@localhost:5432/reputation

# Which LLM drives gap analysis + scoring + content drafting
# Options: anthropic | openai
ORCHESTRATOR=anthropic

# Orchestrator + answer-engine API keys (set the ones you use)
# Core answer engines: Perplexity, ChatGPT/OpenAI-search, Claude/Anthropic, Gemini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Expansion answer engines (optional -- adapters stay inactive until the key is set).
# Each only joins the audit/benchmark once its key is present; absent keys are not
# counted against coverage.
#   Grok (xAI, OpenAI-compatible):
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai
XAI_MODEL=grok-2-latest
#   Google AI Overview (via Serper.dev Google SERP -- captures the AI Overview/answer box):
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev
#   Bing Copilot (set BOTH the key and an OpenAI-compatible base URL for your provider):
BING_COPILOT_API_KEY=
BING_COPILOT_BASE_URL=
BING_COPILOT_MODEL=gpt-4o

# Model IDs (update to current model identifiers when you wire keys)
# Set inside ai_state_audit.py: ORCH_MODEL_ANTHROPIC / ORCH_MODEL_OPENAI

# Crawler
CRAWL_UA=ReputationEngineBot/1.0 (+audit)

# Output
REP_OUTPUT_DIR=output

# Crawler: set to 0 to ignore robots.txt (default respects it)
CRAWL_RESPECT_ROBOTS=1

# Crawler: set to 0 to disable pyseoanalyzer keyword\/SEO enrichment
CRAWL_USE_PYSEO=1

# Content generator (Module 6)
CONTENT_QUALITY_THRESHOLD=0.75
CONTENT_MAX_REVISIONS=2

# Timeline estimator (Module 7)
DOMINANCE_TARGET=0.6
BASE_MONTHLY_GAIN=0.12

# Structured logging: set REP_LOG_JSON=1 for JSON log lines; REP_LOG_LEVEL=INFO
REP_LOG_JSON=0
REP_LOG_LEVEL=INFO

# Firecrawl JS-render fetch (fixes client-side-rendered sites). auto = only when a page looks thin.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE=https://api.firecrawl.dev
CRAWL_FIRECRAWL_MODE=auto

# (NeuronWriter and Katteb were removed from the stack — SERP term/coverage grading is now done
# natively via serp_benchmark + content_quality.serp_grade, so no third-party content-optimization
# API key is needed.)

# Cost levers
ORCH_MODEL_ANTHROPIC_CHEAP=claude-haiku-4-5-20251001
ORCH_MODEL_OPENAI_CHEAP=gpt-4o-mini
CRAWL_ADAPTIVE_SAMPLING=1
# Serper response cache TTL (hours). The audit, competitor benchmark, local-rank tracker, GBP
# ingest, and social audit issue overlapping queries -- caching collapses the duplicate paid calls.
# Set to 0 to disable.
SERPER_CACHE_TTL_HOURS=24
# Anthropic Message Batches scoring: 50% off the per-answer scoring (the dominant audit cost). Off
# by default because it DEFERS scoring (async); best for SCHEDULED audits. Flip to 1 to save ~50%
# on scoring spend. (Prompt caching on the big shared system prompts is applied automatically.)
AUDIT_BATCH_SCORING=0
# Content gate: minimum citation-readiness (0-100, "will an AI quote this?") for a draft to pass
# rather than route to needs_fix.
CONTENT_CITATION_READY_MIN=55
# HeyGen video cost model (developers.heygen.com/docs/pricing). Cost = ACTUAL rendered seconds (from
# HeyGen's response) × the per-second rate for the avatar TIER requested. Update ONLY if HeyGen changes
# pricing; the pre-spend budget guard projects cost from these before a render, and the ledger records
# the real duration × rate. Defaults are HeyGen's published 2026-07 rates ($/sec):
HEYGEN_RATE_AVATAR_STUDIO=0.0667   # Avatar IV Studio / Digital Twin (the v2 talking-avatar default)
HEYGEN_RATE_AVATAR_PHOTO=0.05      # Avatar IV Photo (talking-photo avatar)
HEYGEN_RATE_VIDEO_AGENT=0.0333     # v3 Video Agent (prompt -> produced video)
# Force the avatar tier when the default avatar-id guess is wrong: 'studio' or 'photo' (blank = auto).
HEYGEN_AVATAR_TIER=

# ---------------------------------------------------------------------------
# Integrations & publishing (Connections Vault / Publishing / Approval Queue)
# Everything here is OFF/dormant until you opt in -- the app boots fine without it.
# ---------------------------------------------------------------------------
# At-rest encryption key for stored OAuth tokens / app-passwords (Fernet). REQUIRED before
# connecting any account. MUST differ from JWT_SECRET. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# May be a comma-separated list for rotation (keys[0] encrypts; all decrypt).
TOKEN_ENC_KEY=
# Domain-separated HMAC secret for single-use OAuth `state` values. Falls back to JWT_SECRET
# if unset, but a dedicated secret is preferred.
OAUTH_STATE_SECRET=
# Platform-wide kill switch for ALL automated posting. Default off: even an opted-in tenant
# cannot auto-post until this is true. Set to true only when you are ready to enable auto-post.
AUTOPOST_GLOBAL_ENABLED=false
# Public origin the OAuth provider redirects back to (no trailing slash), e.g.
# https://console.example.com -- used to build the {kind}/callback redirect_uri.
PUBLIC_APP_ORIGIN=http://localhost:3000

# --- Google OAuth (shared client for Business Profile + Search Console + Analytics) ---
# One OAuth client from Google Cloud Console. Add ALL the scopes you intend to use to the consent
# screen: business.manage (GBP review replies + local posts; needs Google allowlist approval ->
# gbp_access='pending'), webmasters.readonly (+ siteverification, GSC search traffic), and
# analytics.readonly (GA4 behavior). Each product is a separate connection with its own scope.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Social publishing provider ---
# Which provider powers the social channels (FB / IG / LinkedIn / X / Pinterest).
# Zernio is the supported DEFAULT; Ayrshare is the fallback alternative -- set
# SOCIAL_PROVIDER=ayrshare to use it instead. Exactly one provider is active.
SOCIAL_PROVIDER=zernia

# Zernio (zernio.com) -- the default social layer. One account-level API key (sk_...); each client
# is a Zernio PROFILE whose social accounts the owner links via an OAuth redirect from Settings.
ZERNIA_API_KEY=
ZERNIA_BASE_URL=https://zernio.com/api/v1

# Ayrshare -- alternative social provider (set SOCIAL_PROVIDER=ayrshare to use). Per-client profile
# key stored encrypted per connection.
AYRSHARE_API_KEY=

# --- Shared platform-app quotas (Wave 5, item 22) -- account-level daily post caps across ALL
#     tenants. Blank = unlimited (current behavior); set to defer auto-posts when the provider cap
#     is reached so a busy day can't blow the API limit mid-campaign.
PLATFORM_QUOTA_AYRSHARE_DAILY=
PLATFORM_QUOTA_X_DAILY=
PLATFORM_QUOTA_GBP_DAILY=

# --- White-label report branding (Wave 5, item 21) -- agency branding for client deliverables.
#     Per-business meta.branding overrides these; blank = the default product brand.
REPORT_BRAND_NAME=
REPORT_BRAND_LOGO=
REPORT_BRAND_ACCENT=

# WordPress uses per-connection Application Passwords (entered in the Connections UI over HTTPS),
# so there is no global WordPress secret here.

# ---------------------------------------------------------------------------
# Visual content generation (CI-4) -- images / quote-cards / video briefs.
# DORMANT until you set a key. Quote-cards render locally (no key). The PROVIDER + MODEL are
# pre-chosen so you only have to drop in the API key.
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=openai            # openai | stability | replicate
IMAGE_MODEL=gpt-image-1          # openai: gpt-image-1 ; stability: (core) ; replicate: model id
IMAGE_API_KEY=                   # leave blank to reuse OPENAI_API_KEY (provider=openai)
# STABILITY_API_KEY / REPLICATE_API_TOKEN are read when IMAGE_PROVIDER is set to those.
# Short-form video: a human-shootable BRIEF (script+shotlist) is always produced from the LLM;
# generative video runs only once a provider + key are set below.
VIDEO_PROVIDER=                  # runway | pika | replicate (scaffold)
VIDEO_MODEL=
VIDEO_API_KEY=

# ---------------------------------------------------------------------------
# Keyword search-volume enrichment (CI-5) -- DORMANT until a key is set. Adds real monthly
# search volume + difficulty to target_keywords on top of the Serper grounding.
# ---------------------------------------------------------------------------
KEYWORD_VOLUME_PROVIDER=         # dataforseo | keywords_everywhere
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
KEYWORDS_EVERYWHERE_API_KEY=

# ---------------------------------------------------------------------------
# NotebookLM API -- Rich Media Generation (podcast / slides / infographic / explainer)
# ---------------------------------------------------------------------------
# Google AI Studio API key with NotebookLM / Semantic Retrieval API access.
# Falls back to GEMINI_API_KEY when not set (same Google key works for both).
# Dormant-safe: with no key, rich_media_generator uses the in-house LLM fallback.
NOTEBOOKLM_API_KEY=
# Base URL for the Semantic Retrieval / NotebookLM API (leave default unless VPC/staging).
NOTEBOOKLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Rich-media asset types to generate each cycle (comma-separated; blank = all).
# Types: podcast, slide_deck, infographic, explainer_video, research_brief,
#        deep_article, blog_series, newsletter
RICH_MEDIA_TYPES=
# Enable rich-media generation in the monthly cycle (0 = off; on-demand generation
# via the "Generate draft" button always works regardless of this flag).
AGENT_RICH_MEDIA_IN_CYCLE=0

# ---------------------------------------------------------------------------
# Adopt batch (2026-07): PageSpeed / Strategy Advisor / Keyword volume
# ---------------------------------------------------------------------------
# PageSpeed Insights (technical-SEO / Core Web Vitals). Free Google API. On by default
# (it's free); set to 0 to disable the feature entirely. Live scores need PAGESPEED_API_KEY —
# a PLAIN Google API key (NOT the AQ.. Gemini auth-key) with the PageSpeed Insights API enabled.
PAGESPEED_ENABLED=1
PAGESPEED_API_KEY=
PAGESPEED_STRATEGY=mobile
PAGESPEED_MAX_URLS=20

# Real keyword search-VOLUME/CPC (Google Keyword Planner data): set KEYWORD_VOLUME_PROVIDER +
# DATAFORSEO_LOGIN/DATAFORSEO_PASSWORD (or KEYWORDS_EVERYWHERE_API_KEY) — all defined earlier in
# this file. Dormant until set; once set, volumes flow into the gap model, strategy, and advisor.

# Strategy Advisor (PDCA loop) tunables — all env-configurable, never hard-coded.
# The goal_alignment that counts as "goal reached" (shared with content-impact). -1..1.
CONTENT_IMPACT_TARGET_ALIGNMENT=0.5
# Below this weekly fraction-of-gap-closed a worked gap is flagged "stalled".
ADVISOR_STALL_VELOCITY=0.02
# Diminishing-returns damping for the pieces-still-needed estimate (each piece ~85% as effective).
ADVISOR_DIMINISH=0.85
# Cap on recommended additional pieces per gap.
ADVISOR_MAX_PIECES_PER_GAP=8

# DataForSEO insufficient-funds guard: skip the paid volume call when the live account balance is
# below this floor (USD), so keyword enrichment degrades gracefully instead of failing. 0 disables.
DATAFORSEO_MIN_BALANCE=0.20
